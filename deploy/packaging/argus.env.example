# Argus control plane configuration (EnvironmentFile= for argus.service).
#
# install-server.sh copies this to /etc/argus/argus.env ONLY if that file
# doesn't already exist -- it never overwrites a config you've already edited.
# Edit the real file (/etc/argus/argus.env), not this example.
#
# Authoritative source: crates/server/src/config.rs.

# ============================================================
# Required -- the control plane refuses to boot without these.
# ============================================================

# Postgres connection string.
ARGUS_DATABASE_URL=postgres://argus:CHANGE_ME@localhost:5432/argus

# Base64 AES-256-GCM key that field-encrypts the internal CA's private key at
# rest. Generate one with:
#   openssl rand -base64 32
ARGUS_FIELD_KEY=

# Externally reachable base URL. Builds the OIDC redirect URI and decides the
# session cookie's Secure attribute (https:// => Secure cookie) -- required
# unconditionally, even for a local-admin-only deployment with no OIDC.
ARGUS_PUBLIC_URL=https://argus.lab.example

# ============================================================
# Optional -- sensible defaults shown commented out below.
# ============================================================

# Listen address for the browser HTTP surface (Traefik upstream).
# Default: 0.0.0.0:8080
#ARGUS_HTTP_ADDR=0.0.0.0:8080

# Listen address for the agent mTLS gRPC surface (MetalLB upstream).
# Default: 0.0.0.0:9443
#ARGUS_AGENT_ADDR=0.0.0.0:9443

# Comma-separated SANs (hostnames/IPs) for the control plane's own
# agent-surface TLS leaf -- the address(es) agents dial to reach it.
# Default: localhost,127.0.0.1
#ARGUS_AGENT_SANS=agents.argus.lab.example,10.0.0.5

# ============================================================
# OIDC -- optional as a GROUP. Set all four of ARGUS_OIDC_ISSUER,
# ARGUS_OIDC_CLIENT_ID, ARGUS_OIDC_CLIENT_SECRET and
# ARGUS_OIDC_REQUIRED_ROLE below to enable SSO, or leave all four unset to
# run with only a local admin. Setting SOME but not all of them is a hard
# boot error -- a half-configured provider must never silently fall back to
# "open to everyone".
# ============================================================

# OIDC issuer URL; every endpoint is read from its discovery document.
#ARGUS_OIDC_ISSUER=https://idp.lab.example/realms/homelab

#ARGUS_OIDC_CLIENT_ID=argus

#ARGUS_OIDC_CLIENT_SECRET=CHANGE_ME

# Role required for admission, or the literal `any`.
#ARGUS_OIDC_REQUIRED_ROLE=argus-admin

# --- OIDC, optional even when SSO above is enabled ---

# Dot-path to the roles claim (Keycloak nests: realm_access.roles).
# Default: groups
#ARGUS_OIDC_ROLES_CLAIM=realm_access.roles

# Space-separated OAuth scopes.
# Default: openid profile email
#ARGUS_OIDC_SCOPES=openid profile email

# PEM path for an IdP behind an internal CA.
#ARGUS_OIDC_CA_CERT=/etc/argus/idp-ca.pem
