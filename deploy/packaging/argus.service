[Unit]
Description=Argus fleet control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd (root, PID 1) reads this file during activation, BEFORE the
# process is spawned and dropped to the DynamicUser UID below -- so a
# root-owned, chmod 600 env file works as intended; the dynamic user never
# needs read access to it itself.
EnvironmentFile=/etc/argus/argus.env
ExecStart=/usr/local/bin/argus
Restart=on-failure
RestartSec=2
# The control plane needs no privileges (binds high ports) and persists
# nothing to disk of its own -- state lives in Postgres (CLAUDE.md: "stateless;
# state in Postgres") and the only file it ever reads is an operator-supplied
# OIDC IdP CA cert (ARGUS_OIDC_CA_CERT, if set), not a directory it owns. So
# DynamicUser alone is sufficient; no StateDirectory is declared.
DynamicUser=yes

[Install]
WantedBy=multi-user.target
