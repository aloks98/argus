# Argus agent configuration (EnvironmentFile= for argus-agent.service, and
# also readable directly via `argus-agent --config <path>` -- same KEY=VALUE
# format, see docs/DEV.md).
#
# install-agent.sh copies this to /etc/argus/agent.env ONLY if that file
# doesn't already exist -- it never overwrites a config you've already
# edited. Edit the real file (/etc/argus/agent.env), not this example.
#
# This is the same block the fleet UI's Enroll page prints under "Run on the
# host" -- if you enrolled through the UI, paste that block's values in here
# instead of filling these placeholders by hand.
#
# Authoritative source: crates/agent/src/config.rs.

# ============================================================
# Required -- the agent refuses to start without these.
# ============================================================

# Control-plane agent endpoint agents dial (MetalLB address, not Traefik).
ARGUS_AGENT_ENDPOINT=https://<agent-endpoint>:9443

# Enrollment join token, minted from the fleet UI's Enroll page.
ARGUS_JOIN_TOKEN=

# ============================================================
# Optional -- shown here with the values the Enroll page recommends.
# ============================================================

# Path to the Argus CA certificate (PEM), downloaded from the Enroll page.
# Default (if unset): <ARGUS_DATA_DIR>/ca.crt
ARGUS_CA_CERT=/etc/argus/argus-ca.crt

# Directory where the agent persists its private key + issued client cert.
# Default (if unset): /var/lib/argus
ARGUS_DATA_DIR=/var/lib/argus-agent
