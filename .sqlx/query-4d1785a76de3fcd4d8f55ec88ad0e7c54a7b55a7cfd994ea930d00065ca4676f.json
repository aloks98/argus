  "db_name": "PostgreSQL",
  "query": "\n        UPDATE enrollment_tokens\n        SET uses = uses + 1\n        WHERE token_hash = $1\n          AND NOT revoked\n          AND (expires_at IS NULL OR expires_at > now())\n          AND (max_uses IS NULL OR uses < max_uses)\n        RETURNING name, display_name, tags as \"tags!\"\n        ",
